  "podManagementPolicy": "OrderedReady",
  "replicas": 0,
  "revisionHistoryLimit": 10,
  "selector": {
    "matchLabels": {
      "app.kubernetes.io/component": "harvester",
      "app.kubernetes.io/instance": "a2a-server",
      "app.kubernetes.io/name": "a2a-server"
    }
  },
  "serviceName": "a2a-server-harvester",
  "template": {
    "metadata": {
      "annotations": {
        "checksum/config": "2ffc5da24c8abd5c852a0fef48f06753a86b7891fd521393b8482a3a06e36669",
        "kubectl.kubernetes.io/restartedAt": "2026-07-12T20:01:23Z"
      },
      "creationTimestamp": null,
      "labels": {
        "app.kubernetes.io/component": "harvester",
        "app.kubernetes.io/instance": "a2a-server",
        "app.kubernetes.io/name": "a2a-server"
      }
    },
    "spec": {
      "containers": [
        {
          "command": [
            "/bin/sh",
            "-c",
            "set -u\nroot=/var/lib/codetether/repos\nretain_days=3\ninterval=3600\nmin_free_pct=20\ngit config --global --add safe.directory '*' >/dev/null 2>&1 || true\nwhile true; do\n  free_pct=$(df -P \"$root\" | awk 'NR==2 {print 100 - int($5)}')\n  echo \"workspace-reclaim: free=${free_pct}% threshold=${min_free_pct}%\"\n  if [ \"$free_pct\" -lt \"$min_free_pct\" ]; then\n    find \"$root\" -maxdepth 1 -mindepth 1 -type d -mtime \"+${retain_days}\" 2>/dev/null |\n    while read -r ws; do\n      name=$(basename \"$ws\")\n      case \"$name\" in .*) continue ;; esac\n      gd=$(find \"$ws\" -maxdepth 2 -name .git -type d 2>/dev/null | head -1)\n      if [ -n \"$gd\" ]; then\n        wt=$(dirname \"$gd\")\n        dirty=$(git -C \"$wt\" status --porcelain 2>/dev/null | wc -l)\n        unpushed=$(git -C \"$wt\" log --branches --not --remotes --oneline 2>/dev/null | wc -l)\n        stash=$(git -C \"$wt\" stash list 2>/dev/null | wc -l)\n        readable=$(git -C \"$wt\" rev-parse --is-inside-work-tree 2>/dev/null || echo no)\n        # Preserve anything unreadable or carrying unsaved work.\n        if [ \"$readable\" != true ] ||\n           [ \"$dirty\" -ne 0 ] || [ \"$unpushed\" -ne 0 ] || [ \"$stash\" -ne 0 ]; then\n          echo \"workspace-reclaim: preserving $name (dirty=$dirty unpushed=$unpushed stash=$stash)\"\n          continue\n        fi\n      fi\n      echo \"workspace-reclaim: reclaiming $name\"\n      rm -rf \"$ws\" || echo \"workspace-reclaim: failed $name\"\n    done\n  fi\n  sleep \"$interval\"\ndone\n"
          ],
          "image": "registry.quantum-forge.net/cluster-ci-cache/codetether-worker:4.7.5-dev.49-forgejo-ro-599230d97ec3",
          "imagePullPolicy": "IfNotPresent",
          "name": "workspace-reclaim",
          "resources": {
            "limits": {
              "cpu": "250m",
              "memory": "256Mi"
            },
            "requests": {
              "cpu": "25m",
              "memory": "64Mi"
            }
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/var/lib/codetether/repos",
              "name": "workspace"
            }
          ]
        },
        {
          "args": [
            "worker",
            "--server",
            "http://a2a-server:8000",
            "--workspaces",
            "/var/lib/codetether/repos",
            "--name",
            "harvester-$(POD_NAME)",
            "--auto-approve",
            "all"
          ],
          "command": [
            "/usr/local/bin/codetether"
          ],
          "env": [
            {
              "name": "POD_NAME",
