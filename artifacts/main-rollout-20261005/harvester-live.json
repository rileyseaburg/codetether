            "runAsUser": 1000
          },
          "terminationMessagePath": "/dev/termination-log",
          "terminationMessagePolicy": "File",
          "volumeMounts": [
            {
              "mountPath": "/var/lib/codetether/repos",
              "name": "workspace"
            },
            {
              "mountPath": "/home/worker",
              "name": "workspace",
              "subPath": ".worker-home"
            },
            {
              "mountPath": "/var/run/secrets/vault",
              "name": "vault-sa-token",
              "readOnly": true
            }
          ]
        }
      ],
      "dnsPolicy": "ClusterFirst",
      "imagePullSecrets": [
        {
          "name": "harbor-regcred"
        },
        {
          "name": "registry-credentials"
        }
      ],
      "restartPolicy": "Always",
      "schedulerName": "default-scheduler",
      "securityContext": {
        "fsGroup": 1000,
        "runAsNonRoot": true,
        "runAsUser": 1000
      },
      "serviceAccount": "a2a-server-harvester",
      "serviceAccountName": "a2a-server-harvester",
      "terminationGracePeriodSeconds": 30,
