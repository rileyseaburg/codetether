              "value": "openai-codex/gpt-6-astra-fast:high"
            },
            {
              "name": "CODETETHER_OPENAI_CODEX_ALLOW_CHATGPT_BACKEND",
              "value": "1"
            }
          ],
          "envFrom": [
            {
              "secretRef": {
                "name": "harvester-api-keys"
              }
            }
          ],
          "image": "registry.quantum-forge.net/cluster-ci-cache/codetether-worker:4.7.5-dev.49-forgejo-ro-599230d97ec3",
          "imagePullPolicy": "IfNotPresent",
