              "value": "604800"
            },
            {
              "name": "GITHUB_PROGRESS_ENABLED",
              "value": "true"
            },
            {
              "name": "CODETETHER_HARVESTER_ENABLED",
              "value": "true"
            },
            {
              "name": "CODETETHER_WORKER_A2A_MDNS",
              "value": "true"
            },
            {
              "name": "CODETETHER_WORKER_PUBLIC_URL",
              "value": "http://$(POD_NAME).a2a-server-harvester.a2a-system.svc.cluster.local:8080"
            },
            {
              "name": "CODETETHER_WORKER_PORT",
              "value": "8080"
            },
            {
              "name": "CODETETHER_WORKER_A2A_PORT",
              "value": "8081"
            },
            {
              "name": "CODETETHER_SERVER",
              "value": "http://a2a-server:8000"
            },
            {
              "name": "CODETETHER_WORKER_CAPABILITIES",
              "value": "harvester,persistent,persistent-workspace,persistent_workspace,git-clone,repo-cache"
            },
            {
              "name": "CODETETHER_TOKEN",
              "valueFrom": {
                "secretKeyRef": {
                  "key": "CODETETHER_TOKEN",
                  "name": "a2a-server-worker-token"
                }
