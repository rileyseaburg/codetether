+use actix_web::web;
+
+/// Registers the existing funnel automation and authoring routes unchanged.
+///
+/// # Examples
+/// ```no_run
+/// let app = actix_web::App::new().configure(launch_platform::routes::api::register);
+/// ```
+pub(super) fn register(cfg: &mut web::ServiceConfig) {
+    cfg.service(crate::controllers::funnel::get_step_automation)
+        .service(crate::controllers::funnel::set_step_automation)
+        .service(crate::controllers::funnel::remove_step_automation)
+        .service(crate::controllers::funnel::list_available_campaigns)
+        .service(
+            web::scope("/templates")
+                .service(crate::controllers::api::templates::get_templates)
+                .service(crate::controllers::api::templates::get_template)
+                .service(crate::controllers::api::templates::create_template)
+                .service(crate::controllers::api::templates::update_template)
+                .service(crate::controllers::api::templates::get_template_versions)
+                .service(crate::controllers::api::templates::create_template_version)
+                .route("/preview/template/{id}",
+                    web::get().to(crate::controllers::api::template_preview::preview_template)),
+        )
+        .service(
+            web::scope("/components")
+                .service(crate::controllers::api::templates::get_components)
+                .service(crate::controllers::api::templates::create_component),
+        )
+        .configure(crate::controllers::api::components::configure)
+        .service(crate::controllers::api::component_purchases::purchase_component_options);
+}
