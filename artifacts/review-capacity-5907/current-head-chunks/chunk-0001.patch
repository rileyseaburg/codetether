+use super::super::responses::TopPerformer;
+use super::summaries;
+use crate::db::models::DriverPerformanceMetrics;
+
+pub fn top_performers(
+    rows: &[DriverPerformanceMetrics],
+    metric: &str,
+    limit: usize,
+) -> Vec<TopPerformer> {
+    let mut items: Vec<_> = summaries(rows)
+        .into_iter()
+        .map(TopPerformer::from)
+        .collect();
+    items.sort_by(|a, b| metric_value(b, metric).total_cmp(&metric_value(a, metric)));
+    items.truncate(limit);
+    items
+}
+
+fn metric_value(item: &TopPerformer, metric: &str) -> f64 {
+    match metric {
+        "rating" => item.avg_rating,
+        "distance" => item.total_distance_km,
+        _ => item.completion_rate,
+    }
+}
