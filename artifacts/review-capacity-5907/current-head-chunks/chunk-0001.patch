+        funnel_session_token: None,
+        forward_attempts: Some(0),
+        last_forward_error: None,
+        crm_lead_id: event.crm_lead_id,
+        crm_contact_id: None,
+        journey_person_key: None,
+        journey_session_key: None,
+    }
