@@ -0,0 +1,48 @@
+import { ORPCError } from '@orpc/server';
+import { getStripeClient } from '../stripe/client.js';
+import { requireBookingDatabase } from './bookingDatabase.js';
+import { findBookingRecord } from './bookingContextRead.js';
+import { writeBookingRelease } from './bookingReleaseWrites.js';
+import type { ReleaseBookingInput } from './bookingReleaseSchemas.js';
+
+/** Cancels a pending intent before releasing its corresponding held service window.
+ * The booking lock serializes reschedule/decline; Stripe arbitrates charge/cancel.
+ * A failed or ambiguous cancellation leaves the capacity hold unchanged.
+ * @example `const result = await releaseExteriorBookingHold(input);`
+ */
+export async function releaseExteriorBookingHold(input: ReleaseBookingInput) {
+  return requireBookingDatabase().transaction(async tx => {
+    const booking = await findBookingRecord(input, tx, true, true);
+    if (!booking) return null;
+    const response = { quoteId: booking.quoteId, bookingId: booking.bookingId, released: true as const };
+    if (booking.status === 'cancelled' && booking.paymentStatus === 'cancelled') return response;
+    if (!['held', 'awaiting_time'].includes(booking.status) || !booking.stripePaymentIntentId) {
+      throw new ORPCError('CONFLICT', { message: 'This booking cannot be released from checkout.' });
+    }
+    if (!booking.arrivalWindowStartsAt
+      || booking.arrivalWindowStartsAt.getTime() !== new Date(input.acknowledgedStart).getTime()) {
+      throw new ORPCError('CONFLICT', { message: 'The held service window changed. Review it before declining.' });
+    }
+    const stripe = getStripeClient();
+    try {
+      const intent = await stripe.paymentIntents.retrieve(booking.stripePaymentIntentId);
+      if (intent.status === 'succeeded' || intent.amount_received > 0) {
+        throw new ORPCError('CONFLICT', { message: 'Payment was already collected; the booking was not released.' });
+      }
+      const cancelled = intent.status === 'canceled' ? intent
+        : await stripe.paymentIntents.cancel(intent.id, { cancellation_reason: 'requested_by_customer' }, {
+          idempotencyKey: `exterior-booking:${intent.id}:decline`,
+        });
+      if (cancelled.status !== 'canceled' || cancelled.amount_received > 0) {
+        throw new ORPCError('CONFLICT', { message: 'Payment cancellation is not confirmed; the booking was not released.' });
+      }
+    } catch (error) {
+      if (error instanceof ORPCError) throw error;
+      throw new ORPCError('CONFLICT', {
+        message: `Payment cancellation failed; the booking was not released. ${error instanceof Error ? error.message : 'Stripe response unavailable.'}`,
+      });
+    }
+    await writeBookingRelease(tx, booking);
+    return response;
+  });
+}
