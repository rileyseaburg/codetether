@@ -0,0 +1,37 @@
+import { and, eq, inArray, sql } from 'drizzle-orm';
+import { service_bookings as bookings, service_booking_status_events as events,
+  exterior_quote_requests as quotes, exterior_route_jobs as jobs } from '../db/drizzle/schema.js';
+import type { BookingTransaction } from './bookingDatabase.js';
+import type { BookingContext } from './bookingContextRepository.js';
+import type { readBookingAvailabilitySlots } from './bookingAvailabilitySlots.js';
+
+/** Holds a still-editable booking and mirrors its arrival window into operations.
+ * @example `const expires = await writeBookingHold(tx, booking, slot);`
+ */
+export async function writeBookingHold(
+  tx: BookingTransaction, booking: BookingContext,
+  slot: Awaited<ReturnType<typeof readBookingAvailabilitySlots>>[number],
+) {
+  const startsAt = slot.start.toISOString();
+  const endsAt = slot.end.toISOString();
+  const [updated] = await tx.update(bookings).set({
+    status: 'held', service_starts_at: startsAt, service_ends_at: slot.serviceEnd.toISOString(),
+    arrival_window_starts_at: startsAt, arrival_window_ends_at: endsAt,
+    hold_expires_at: sql`clock_timestamp() + make_interval(mins => ${booking.holdDurationMinutes})`,
+    updated_at: sql`now()`, version: sql`${bookings.version} + 1`,
+  }).where(and(eq(bookings.id, booking.bookingId), inArray(bookings.status, ['awaiting_time', 'held'])))
+    .returning({ expires: bookings.hold_expires_at });
+  if (!updated?.expires) throw new Error('Booking changed before the hold was saved.');
+  await tx.update(quotes).set({ selected_window_start: startsAt, selected_window_end: endsAt,
+    routing_status: 'held_pending_payment', updated_at: sql`now()`,
+  }).where(eq(quotes.id, booking.quoteId));
+  await tx.update(jobs).set({ selected_window_start: startsAt, selected_window_end: endsAt,
+    routing_status: 'held_pending_payment', updated_at: sql`now()`,
+  }).where(eq(jobs.quote_request_id, booking.quoteId));
+  await tx.insert(events).values({ booking_id: booking.bookingId, from_status: booking.status,
+    to_status: 'held', actor_type: 'customer', reason: 'Customer selected service time',
+    metadata: { service_starts_at: startsAt, service_ends_at: slot.serviceEnd.toISOString(),
+      arrival_window_ends_at: endsAt, hold_expires_at: updated.expires },
+  });
+  return updated.expires;
+}
