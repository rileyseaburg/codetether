diff --git a/spotless-web/ui/components/ads/unified/steps/CampaignConfiguration/components/FacebookAudiences.tsx b/spotless-web/ui/components/ads/unified/steps/CampaignConfiguration/components/FacebookAudiences.tsx
new file mode 100644
index 0000000000..abfec19cc9
--- /dev/null
+++ b/spotless-web/ui/components/ads/unified/steps/CampaignConfiguration/components/FacebookAudiences.tsx
@@ -0,0 +1,58 @@
+import type { CampaignConfig } from '../types'
+import { useFacebookAudiences } from '../hooks/useFacebookAudiences'
+import { facebookAudienceIds } from '../utils/facebookAudienceIds'
+
+/** Include or exclude native custom/lookalike audiences belonging to the chosen account. */
+export function FacebookAudiences({ config, onUpdateConfig }: {
+  config: CampaignConfig | undefined
+  onUpdateConfig: (field: string, value: unknown) => void
+}) {
+  const { audiences, loading, error, reload } = useFacebookAudiences(config?.adAccountId)
+  const targeting: Record<string, unknown> = config?.targeting ?? {}
+  return (
+    <fieldset className="space-y-3 border-t pt-4">
+      <legend className="font-semibold">Facebook custom audiences</legend>
+      <p className="text-sm">Optional: include or exclude existing custom and lookalike audiences.
+        Unset fields retain zone-level audience defaults; use Clear to explicitly select none.
+        Geography and demographics still apply. Changing ad accounts clears these selections.</p>
+      {!config?.adAccountId && <p>Select a Facebook ad account first.</p>}
+      {loading && <p role="status">Loading Facebook audiences…</p>}
+      {error && <p role="alert">{error}</p>}
+      <button type="button" onClick={reload} disabled={loading || !config?.adAccountId}
+        className="rounded border px-3 py-1">Refresh audiences</button>
+      {!loading && !error && config?.adAccountId && audiences.length === 0 && (
+        <p>No custom audiences were returned for this account.</p>
+      )}
+      <div className="grid gap-4 sm:grid-cols-2">
+        {(['custom_audiences', 'excluded_custom_audiences'] as const).map(field => {
+          const selected = facebookAudienceIds(targeting[field])
+          const opposite = field === 'custom_audiences'
+            ? 'excluded_custom_audiences' : 'custom_audiences'
+          const excluded = facebookAudienceIds(targeting[opposite])
+          const unavailable = selected.filter(id => !audiences.some(audience => audience.id === id))
+          return <label key={field} className="text-sm">
+            {field === 'custom_audiences' ? 'Include audiences' : 'Exclude audiences'}
+            <select multiple size={5} value={selected} disabled={loading || Boolean(error) || !config?.adAccountId}
+              className="w-full rounded border p-2 dark:bg-gray-700 dark:text-white"
+              onChange={event => onUpdateConfig('targeting', { ...targeting,
+                [field]: Array.from(event.target.selectedOptions, option => ({ id: option.value })),
+              })}>
+              {audiences.map(audience => <option key={audience.id} value={audience.id}
+                disabled={excluded.includes(audience.id)}>{audience.name} ({audience.type})</option>)}
+              {unavailable.map(id => <option key={id} value={id}>{id} (not in loaded list)</option>)}
+            </select>
+            {targeting[field] === undefined && <span className="block text-xs">
+              No campaign override; zone-level defaults apply.
+            </span>}
+            <button type="button" className="underline"
+              onClick={() => onUpdateConfig('targeting', { ...targeting, [field]: [] })}>
+              Clear {field === 'custom_audiences' ? 'inclusions' : 'exclusions'}
+            </button>
+          </label>
+        })}
+      </div>
+      <p className="text-xs">Shows up to 100 audiences per lookup. Hold Ctrl or Command to select
+        multiple. Saved audiences are not custom-audience IDs and are not listed here.</p>
+    </fieldset>
+  )
+}
\ No newline at end of file
diff --git a/spotless-web/ui/components/ads/unified/steps/CampaignConfiguration/components/FacebookDemographics.tsx b/spotless-web/ui/components/ads/unified/steps/CampaignConfiguration/components/FacebookDemographics.tsx
new file mode 100644
index 0000000000..66ebff7ecd
--- /dev/null
+++ b/spotless-web/ui/components/ads/unified/steps/CampaignConfiguration/components/FacebookDemographics.tsx
@@ -0,0 +1,53 @@
+import type { CampaignConfig } from '../types'
+
+const ages = Array.from({ length: 48 }, (_, index) => index + 18)
+const selectClass = 'w-full rounded-md border p-2 dark:bg-gray-700 dark:text-white'
+
+/** Explicit adult demographic selections stored in the provider's targeting shape. */
+export function FacebookDemographics({ config, onUpdateConfig }: {
+  config: CampaignConfig | undefined
+  onUpdateConfig: (field: string, value: unknown) => void
+}) {
+  const targeting: Record<string, unknown> = config?.targeting ?? {}
+  const update = (field: string, value: unknown) =>
+    onUpdateConfig('targeting', { ...targeting, [field]: value })
+  const genders = targeting.genders
+  const gender = Array.isArray(genders)
+    ? genders.length === 1 ? String(genders[0]) : 'all' : ''
+  return (
+    <fieldset className="space-y-3 border-t pt-4">
+      <legend className="font-semibold">Facebook age and gender targeting</legend>
+      <p className="text-sm">Choose who to target within your selected geographic areas.
+        This wizard targets adults; maximum age 65 means 65+.</p>
+      <div className="grid gap-3 sm:grid-cols-3">
+        {(['age_min', 'age_max'] as const).map(field => (
+          <label key={field} className="text-sm">
+            {field === 'age_min' ? 'Minimum age' : 'Maximum age'}
+            <select className={selectClass} required
+              value={typeof targeting[field] === 'number' ? targeting[field] : ''}
+              onChange={event => update(field, event.target.value === ''
+                ? undefined : Number(event.target.value))}>
+              <option value="">Select age</option>
+              {ages.map(age => <option key={age} value={age} disabled={
+                field === 'age_min' && typeof targeting.age_max === 'number'
+                  ? age > targeting.age_max
+                  : field === 'age_max' && typeof targeting.age_min === 'number'
+                    ? age < targeting.age_min : false
+              }>{age === 65 ? '65+' : age}</option>)}
+            </select>
+          </label>
+        ))}
+        <label className="text-sm">Gender
+          <select className={selectClass} required value={gender}
+            onChange={event => update('genders', event.target.value === '' ? undefined
+              : event.target.value === 'all' ? [1, 2] : [Number(event.target.value)])}>
+            <option value="">Select gender targeting</option>
+            <option value="all">All genders</option>
