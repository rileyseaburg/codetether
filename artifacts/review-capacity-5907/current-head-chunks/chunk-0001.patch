+import type { PlatformTargeting } from '../types'
+
+const geographicFields = [
+  'geo_locations', 'excluded_geo_locations', 'proximity_targets',
+  'excluded_proximity_targets', 'proximity', 'geo_targets', 'location_ids',
+  'location_type', 'locations',
+]
+
+/** Replace geography without erasing audience inclusions, exclusions or demographics. */
+export function replaceGeographicTargeting(
+  current: PlatformTargeting | undefined,
+  geography: PlatformTargeting | undefined,
+): PlatformTargeting {
+  const targeting: PlatformTargeting & Record<string, unknown> = { ...current }
+  for (const key of geographicFields) delete targeting[key]
+  return { ...targeting, ...geography }
+}
