+import { ORPCError } from '@orpc/server';
+import { and, desc, eq, inArray } from 'drizzle-orm';
+import { exterior_quote_requests as quotes, exterior_quote_payments as payments,
+  exterior_quote_booking_links as links, service_bookings as bookings,
+  service_offerings as offerings, booking_capacity_pools as pools } from '../db/drizzle/schema.js';
+import { bookingContextProjection } from './bookingContextProjection.js';
+import { requireBookingDatabase, type BookingDatabase } from './bookingDatabase.js';
+import type { BookingAuthorizationInput } from './bookingSchemas.js';
+
+/** Authorizes only the supplied quote-bound secret and permitted payment states.
+ * Cancelled checkouts are readable solely for idempotent decline acknowledgments.
+ * @example `const booking = await findBookingRecord(input);`
+ */
+export async function findBookingRecord(
+  input: BookingAuthorizationInput,
+  db: BookingDatabase = requireBookingDatabase(),
+  allowCancelled = false,
+  lock = false,
+) {
+  const query = db.select(bookingContextProjection).from(payments)
+    .innerJoin(quotes, eq(quotes.id, payments.quote_request_id))
+    .innerJoin(links, eq(links.quote_request_id, quotes.id))
+    .innerJoin(bookings, eq(bookings.id, links.booking_id))
+    .innerJoin(offerings, eq(offerings.id, bookings.service_offering_id))
+    .innerJoin(pools, eq(pools.id, bookings.capacity_pool_id))
+    .where(and(eq(payments.quote_request_id, input.quoteRequestId),
+      eq(payments.stripe_client_secret, input.credential),
+      inArray(payments.payment_status, allowCancelled ? ['payment_pending', 'cancelled'] : ['payment_pending']),
+      allowCancelled ? undefined : and(eq(offerings.active, true), eq(pools.active, true))))
+    .orderBy(desc(payments.id)).limit(1);
+  try {
+    const [row] = await (lock ? query.for('update', { of: bookings }) : query);
+    return row ?? null;
+  } catch (error) {
+    // Drizzle exceptions may embed bound parameters, including the quote secret.
+    // Preserve only the safe PostgreSQL diagnostic code, never the raw exception.
+    const cause = error && typeof error === 'object' && 'cause' in error ? error.cause : undefined;
+    const rawCode = cause && typeof cause === 'object' && 'code' in cause ? cause.code : undefined;
+    const databaseCode = typeof rawCode === 'string' && /^[A-Z0-9]{5}$/.test(rawCode) ? rawCode : undefined;
+    throw new ORPCError('SERVICE_UNAVAILABLE', {
+      message: 'Secure booking authorization lookup is temporarily unavailable.',
+      data: { code: 'BOOKING_CONTEXT_LOOKUP_FAILED', databaseCode },
+    });
+  }
+}
