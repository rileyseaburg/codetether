+use super::super::convert::round_two;
+
+pub fn rate(numerator: i32, denominator: i32) -> f64 {
+    if denominator > 0 {
+        round_two(numerator as f64 / denominator as f64 * 100.0)
+    } else {
+        0.0
+    }
+}
+
+pub fn average(sum: f64, count: usize) -> f64 {
+    if count > 0 {
+        round_two(sum / count as f64)
+    } else {
+        0.0
+    }
+}
