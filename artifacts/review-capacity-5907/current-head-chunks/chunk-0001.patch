@@ -0,0 +1,51 @@
+import { useEffect, useState } from 'react'
+import { facebookListAudiences } from '@/client-typescript-api/sdk.gen'
+import type { FacebookListAudiencesResponse } from '@/client-typescript-api/types.gen'
+import { getToken } from '@/lib/keycloak'
+
+type Audience = FacebookListAudiencesResponse['audiences'][number]
+type State = { accountId?: string; audiences: Audience[]; loading: boolean; error?: string }
+
+/** Load only real, account-scoped native audiences; never substitute a mock catalogue. */
+export function useFacebookAudiences(accountId?: string) {
+  const [attempt, setAttempt] = useState(0)
+  const [state, setState] = useState<State>({ audiences: [], loading: false })
+  useEffect(() => {
+    const controller = new AbortController()
+    if (!accountId) {
+      setState({ audiences: [], loading: false })
+      return () => controller.abort()
+    }
+    setState({ accountId, audiences: [], loading: true })
+    const load = async () => {
+      try {
+        const token = getToken()
+        if (!token) throw new Error('Sign in to load Facebook audiences.')
+        const result = await facebookListAudiences({
+          body: { accountId, limit: 100, includeSaved: false },
+          headers: { Authorization: `Bearer ${token}` },
+          credentials: 'include', signal: controller.signal,
+        })
+        if (result.error || !result.data) {
+          throw new Error(`Facebook audience lookup failed (HTTP ${result.response.status}).`)
+        }
+        if (result.data.accountId.replace(/^act_/, '') !== accountId.replace(/^act_/, '')) {
+          throw new Error('Facebook returned audiences for a different ad account.')
+        }
+        if (!controller.signal.aborted) setState({ accountId, loading: false,
+          audiences: result.data.audiences.filter(audience => audience.type !== 'saved'),
+        })
+      } catch (error) {
+        if (!controller.signal.aborted) setState({ accountId, audiences: [], loading: false,
+          error: error instanceof Error ? error.message : 'Facebook audience lookup failed.',
+        })
+      }
+    }
+    void load()
+    return () => controller.abort()
+  }, [accountId, attempt])
+  const current = state.accountId === accountId ? state : {
+    accountId, audiences: [], loading: Boolean(accountId),
+  }
+  return { ...current, reload: () => setAttempt(value => value + 1) }
+}
