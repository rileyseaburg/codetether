+        "amount": response.get("amount").cloned().unwrap_or(json!(payload.amount)),
+        "is_subscription": response.get("is_subscription").cloned(),
+        "service_id": payload.service_id,
+        "service_type": payload.service_type,
+        "offer_token": payload.offer_token,
+        "payment_method_types": payload.payment_method_types,
+        "session_id": payload.session_id,
+        "utm_source": attr(req, &payload.utm_source, "utm_source"),
+        "utm_medium": attr(req, &payload.utm_medium, "utm_medium"),
+        "utm_campaign": attr(req, &payload.utm_campaign, "utm_campaign"),
+        "utm_content": attr(req, &payload.utm_content, "utm_content"),
+        "utm_term": attr(req, &payload.utm_term, "utm_term"),
