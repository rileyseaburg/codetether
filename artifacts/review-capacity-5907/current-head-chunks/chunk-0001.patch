+++ b/src/controllers/funnel/seamless_checkout/payment_intent/metadata_request.rs
@@ -0,0 +1,42 @@
+use actix_web::{http::header, HttpRequest};
+use url::{form_urlencoded, Url};
+
+/// Reads attribution from the current request URL or its funnel-page referer.
+pub fn request_param(req: &HttpRequest, key: &str) -> Option<String> {
+    query_param(req.uri().query(), key).or_else(|| referer_param(req, key))
+}
+
+pub fn preferred_param(req: &HttpRequest, body: &Option<String>, key: &str) -> Option<String> {
+    request_param(req, key)
+        .or_else(|| body.as_ref().filter(|value| !value.is_empty()).cloned())
+        .or_else(|| cookie_param(req, key))
+}
+
+pub fn session_identity(req: &HttpRequest, body: &Option<String>, fallback: &str) -> String {
+    preferred_param(req, body, "sb_session")
+        .or_else(|| cookie_param(req, "cid"))
+        .unwrap_or_else(|| fallback.to_string())
+}
+
+fn cookie_param(req: &HttpRequest, key: &str) -> Option<String> {
+    req.cookie(key)
+        .map(|cookie| cookie.value().to_string())
+        .filter(|value| !value.is_empty())
+}
+
+fn referer_param(req: &HttpRequest, key: &str) -> Option<String> {
+    let referer = req.headers().get(header::REFERER)?.to_str().ok()?;
+    let url = Url::parse(referer).ok()?;
+    query_param(url.query(), key)
+}
+
+fn query_param(query: Option<&str>, key: &str) -> Option<String> {
+    let query = query?;
+    form_urlencoded::parse(query.as_bytes()).find_map(|(name, value)| {
+        if name == key && !value.is_empty() {
+            Some(value.into_owned())
+        } else {
+            None
+        }
+    })
+}
