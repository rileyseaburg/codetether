+use crate::db::{models::NewAnalyticsEvents, repositories::create_analytics_events};
+use crate::routes::api::analytics::AnalyticsEvent;
+use std::time::Duration;
+
+const ANALYTICS_DEADLINE: Duration = Duration::from_millis(250);
+
+pub async fn persist_checkout_event(event: AnalyticsEvent) {
+    match tokio::time::timeout(ANALYTICS_DEADLINE, persist_generated(event)).await {
+        Ok(Ok(())) => {}
+        Ok(Err(error)) => tracing::warn!(%error, "could not persist checkout analytics"),
+        Err(_) => tracing::warn!(
+            deadline_ms = ANALYTICS_DEADLINE.as_millis(),
+            "checkout analytics persistence timed out"
+        ),
+    }
+}
+
+async fn persist_generated(event: AnalyticsEvent) -> Result<(), String> {
+    let pool = crate::db_pool::get_or_init_pool().await?;
+    create_analytics_events(pool, analytics_input(event))
+        .await
+        .map(|_| ())
+        .map_err(|error| error.to_string())
+}
+
+fn analytics_input(event: AnalyticsEvent) -> NewAnalyticsEvents {
+    NewAnalyticsEvents {
+        event_name: event.event,
+        event_id: event.event_id,
+        session_id: event.session_id,
+        user_id: event.uid,
+        page_url: event.page_url,
