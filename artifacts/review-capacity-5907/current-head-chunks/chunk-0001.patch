@@ -0,0 +1,37 @@
+/** Validate explicit demographics and native audience IDs before wizard submission. */
+export function facebookAudienceIssues(value: unknown): string[] {
+  const targeting = value && typeof value === 'object'
+    ? value as Record<string, unknown> : {}
+  const issues: string[] = []
+  const min = targeting.age_min
+  const max = targeting.age_max
+  const validAge = (age: unknown): age is number =>
+    typeof age === 'number' && Number.isInteger(age) && age >= 18 && age <= 65
+  if (!validAge(min) || !validAge(max)) {
+    issues.push('Facebook: select minimum and maximum ages (18–65+).')
+  } else if (min > max) {
+    issues.push('Facebook: minimum age cannot exceed maximum age.')
+  }
+  const genders = targeting.genders
+  if (!Array.isArray(genders) || genders.some(gender => gender !== 1 && gender !== 2)) {
+    issues.push('Facebook: choose All genders, Men, or Women.')
+  }
+  const audienceIds = (field: string): string[] => {
+    const values = targeting[field]
+    if (values === undefined) return []
+    if (!Array.isArray(values)) {
+      issues.push(`Facebook: ${field} must contain native audience IDs.`)
+      return []
+    }
+    return values.flatMap(value => {
+      if (value && typeof value === 'object' && typeof value.id === 'string'
+        && /^\d+$/.test(value.id)) return [value.id]
+      issues.push(`Facebook: ${field} contains an invalid audience ID.`)
+      return []
+    })
+  }
+  const included = audienceIds('custom_audiences')
+  const excluded = audienceIds('excluded_custom_audiences')
+  if (included.some(id => excluded.includes(id))) issues.push('Facebook: an audience cannot be both included and excluded.')
+  return issues
+}
