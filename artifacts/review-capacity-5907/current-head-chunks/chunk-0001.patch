+import { ORPCError } from '@orpc/server';
+import { getStripeClient } from '../stripe/client.js';
+
+/** Rejects rescheduling while Stripe has collected, cancelled, or is processing money.
+ * Used under the booking row lock to close the confirm/reschedule race.
+ * @example `await assertBookingPaymentEditable(paymentIntentId);`
+ */
+export async function assertBookingPaymentEditable(paymentIntentId: string | null) {
+  if (!paymentIntentId) throw new ORPCError('CONFLICT', { message: 'The payment session is unavailable.' });
+  const intent = await getStripeClient().paymentIntents.retrieve(paymentIntentId);
+  if (intent.amount_received > 0 || !['requires_payment_method', 'requires_confirmation'].includes(intent.status)) {
+    throw new ORPCError('CONFLICT', {
+      message: 'Payment is no longer editable. Check the booking status before selecting another time.',
+    });
+  }
+}
