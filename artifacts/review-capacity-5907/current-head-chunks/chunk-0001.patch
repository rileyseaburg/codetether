+        spotless_vid: session.clone(),
+        session_id: Some(session.clone()),
+        uid: Some(session),
+        customer_id: None,
+        lead_id: None,
+        email: None,
+        fbp: preferred_param(req, &p.fbp, "_fbp"),
+        fbc: preferred_param(req, &p.fbc, "_fbc"),
+        gclid: preferred_param(req, &p.gclid, "gclid"),
+        ttclid: preferred_param(req, &p.ttclid, "ttclid"),
+        touchpoint_type: "checkout_start".to_string(),
+        source: preferred_param(req, &p.utm_source, "utm_source"),
+        medium: preferred_param(req, &p.utm_medium, "utm_medium"),
+        campaign: preferred_param(req, &p.utm_campaign, "utm_campaign"),
+        ad_set: None,
+        ad_id: None,
+        content: preferred_param(req, &p.utm_content, "utm_content"),
+        term: preferred_param(req, &p.utm_term, "utm_term"),
+        landing_url: Some(page.clone()),
+        page_url: Some(page),
+        referrer: attribution.referer,
+        client_ip: Some(attribution.client_ip),
+        user_agent: attribution.user_agent,
+        value: None,
+        currency: Some(Some("USD".to_string())),
+        event_id: Some(format!("checkout_start_{}", uuid::Uuid::new_v4())),
+        touched_at: Some(chrono::Utc::now()),
+        created_at: None,
+        journey_person_key: None,
+        journey_session_key: None,
+        canonical_crm_lead_id: None,
+        crm_contact_id: None,
+    }
+}
