+pub async fn record_checkout_touchpoint(payload: &CreatePaymentIntentRequest, req: &HttpRequest) {
+    match tokio::time::timeout(
+        TOUCHPOINT_DEADLINE,
+        persist_generated(checkout_touchpoint(payload, req)),
+    )
+    .await
+    {
+        Ok(Ok(())) => {}
+        Ok(Err(error)) => tracing::warn!(%error, "could not persist checkout touchpoint"),
+        Err(_) => tracing::warn!(
+            deadline_ms = TOUCHPOINT_DEADLINE.as_millis(),
+            "checkout touchpoint persistence timed out"
+        ),
+    }
