diff --git a/api/src/exterior-quote/bookingChargeGuard.ts b/api/src/exterior-quote/bookingChargeGuard.ts
new file mode 100644
index 0000000000..874f9876d5
--- /dev/null
+++ b/api/src/exterior-quote/bookingChargeGuard.ts
@@ -0,0 +1,53 @@
+import { ORPCError } from '@orpc/server';
+import { eq, sql } from 'drizzle-orm';
+import { service_bookings } from '../db/drizzle/schema.js';
+import { requireBookingDatabase } from './bookingDatabase.js';
+import { findBookingRecord } from './bookingContextRead.js';
+import { bookingServiceDate } from './bookingServiceDate.js';
+import { chargeQuotePaymentIntent } from './bookingChargeProvider.js';
+import { findSavedPaymentMethod } from './savedPaymentMethod.js';
+import { UnattachedPaymentMethodError } from './bookingChargeErrors.js';
+import { recordBookingChargeTelemetry } from './bookingChargeTelemetry.js';
+import type { AuthorizeBookingChargeInput } from './bookingChargeSchemas.js';
+
+/** Charges only an unexpired, acknowledged hold while reschedule/decline are locked out.
+ * Capacity-day locking prevents another hold claiming a slot during confirmation.
+ * The existing intent and quoted amount are read from the same authorized record.
+ * @example `const result = await chargeAcknowledgedBooking(input);`
+ */
+export async function chargeAcknowledgedBooking(input: AuthorizeBookingChargeInput) {
+  const result = await requireBookingDatabase().transaction(async tx => {
+    const booking = await findBookingRecord(input, tx, false, true);
+    if (!booking) throw new ORPCError('NOT_FOUND', { message: 'This secure checkout is no longer available.' });
+    const held = booking.arrivalWindowStartsAt;
+    if (booking.status !== 'held' || !held || !booking.stripePaymentIntentId) {
+      throw new ORPCError('CONFLICT', { message: 'Choose a service time before authorizing payment.' });
+    }
+    if (held.getTime() !== new Date(input.acknowledgedStart).getTime()) {
+      throw new ORPCError('CONFLICT', { message: 'The service window changed. Review it before paying.' });
+    }
+    const key = `service-booking:${booking.capacityPoolId}:${bookingServiceDate(held, booking.timezone)}`;
+    await tx.select({ locked: sql`pg_advisory_xact_lock(hashtextextended(${key}, 0))` })
+      .from(service_bookings).where(eq(service_bookings.id, booking.bookingId));
+    const [window] = await tx.select({ valid: sql<boolean>`${service_bookings.hold_expires_at} > clock_timestamp()` })
+      .from(service_bookings).where(eq(service_bookings.id, booking.bookingId));
+    if (!window?.valid) throw new ORPCError('CONFLICT', { message: 'Your service-time hold expired. Select a new window.' });
+    await tx.update(service_bookings).set({
+      hold_expires_at: sql`greatest(${service_bookings.hold_expires_at}, clock_timestamp() + make_interval(mins => ${booking.holdDurationMinutes}))`,
+      updated_at: sql`now()`, version: sql`${service_bookings.version} + 1`,
+    }).where(eq(service_bookings.id, booking.bookingId));
+    const saved = await findSavedPaymentMethod(booking.quoteId);
+    try {
+      const charged = await chargeQuotePaymentIntent(booking.stripePaymentIntentId, saved, booking.amountQuotedCents);
+      return { ok: true as const, booking, held, charged };
+    } catch (error) {
+      await recordBookingChargeTelemetry(input, booking.stripePaymentIntentId, 'provider_error');
+      const message = error instanceof UnattachedPaymentMethodError ? 'Add a payment method before authorizing this charge.'
+        : `Payment could not be confirmed: ${error instanceof Error ? error.message : 'Stripe response unavailable.'}`;
+      // Commit the extended hold even when Stripe's response is uncertain.
+      return { ok: false as const, failure: new ORPCError('CONFLICT', { message }) };
+    }
+  });
+  if (!result.ok) throw result.failure;
+  return result;
+}
