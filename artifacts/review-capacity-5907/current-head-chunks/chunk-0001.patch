+import { ORPCError } from '@orpc/server';
+import { drizzleDb, type Database } from '../db/drizzleClient.js';
+
+/** Transaction type owned by the generated-schema Drizzle client.
+ * @example `const tx: BookingTransaction = transaction;` */
+export type BookingTransaction = Parameters<Parameters<Database['transaction']>[0]>[0];
+/** Shared database or transaction used for booking reads.
+ * @example `const db: BookingDatabase = requireBookingDatabase();` */
+export type BookingDatabase = Database | BookingTransaction;
+
+/** Fails explicitly when the booking system of record is unavailable.
+ * @example `const db = requireBookingDatabase();` */
+export function requireBookingDatabase(): Database {
+  if (!drizzleDb) throw new ORPCError('SERVICE_UNAVAILABLE', { message: 'Booking database is unavailable' });
+  return drizzleDb;
+}
