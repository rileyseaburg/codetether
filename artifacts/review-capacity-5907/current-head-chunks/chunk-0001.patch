+/** Resolves the operations-local calendar date for capacity locking.
+ * @example `bookingServiceDate(new Date('2026-09-08T14:00:00Z'), 'America/Chicago');`
+ */
+export function bookingServiceDate(value: Date, timezone: string): string {
+  const parts = new Intl.DateTimeFormat('en-CA', {
+    timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit',
+  }).formatToParts(value);
+  const year = parts.find(part => part.type === 'year')?.value;
+  const month = parts.find(part => part.type === 'month')?.value;
+  const day = parts.find(part => part.type === 'day')?.value;
+  if (!year || !month || !day) throw new Error('Could not resolve the booking service date.');
+  return `${year}-${month}-${day}`;
+}
