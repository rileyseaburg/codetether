+import { sql } from 'drizzle-orm';
+import { exterior_quote_requests as quotes, service_bookings as bookings,
+  service_offerings as offerings, booking_capacity_pools as pools,
+  exterior_quote_payments as payments } from '../db/drizzle/schema.js';
+
+/** Normalizes nullable database timestamps without manufacturing dates.
+ * @example `bookingDate('2026-09-08T14:00:00Z');`
+ */
+export function bookingDate(value: unknown): Date | null {
+  if (value == null) return null;
+  const date = value instanceof Date ? value : typeof value === 'string' ? new Date(value) : null;
+  if (!date || !Number.isFinite(date.getTime())) throw new TypeError('Invalid booking timestamp');
+  return date;
+}
+
+/** Projection derives every field from RustyRoad-generated tables.
+ * @example `const selection = bookingContextProjection;` */
+export const bookingContextProjection = {
+  quoteId: quotes.id, bookingId: bookings.id, serviceName: offerings.name,
+  capacityPoolId: bookings.capacity_pool_id, timezone: pools.timezone,
+  budgetedMinutes: bookings.budgeted_minutes, minimumLeadMinutes: offerings.minimum_lead_minutes,
+  maximumAdvanceDays: offerings.maximum_advance_days, slotIntervalMinutes: offerings.slot_interval_minutes,
+  arrivalWindowMinutes: offerings.arrival_window_minutes, holdDurationMinutes: offerings.hold_duration_minutes,
+  dailyCapacityMinutes: pools.daily_capacity_minutes, parallelCapacity: pools.parallel_capacity,
+  operationsKey: pools.operations_key, status: bookings.status,
+  arrivalWindowStartsAt: sql`${bookings.arrival_window_starts_at}`.mapWith(bookingDate),
+  arrivalWindowEndsAt: sql`${bookings.arrival_window_ends_at}`.mapWith(bookingDate),
+  holdExpiresAt: sql`${bookings.hold_expires_at}`.mapWith(bookingDate),
+  paymentId: payments.id, stripePaymentIntentId: payments.stripe_payment_intent_id,
+  paymentStatus: payments.payment_status, amountQuotedCents: payments.amount_quoted_cents,
+  currency: payments.currency,
+};
