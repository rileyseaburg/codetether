--- /dev/null
+++ b/src/controllers/driver/performance/service/data.rs
@@ -0,0 +1,39 @@
+use super::super::convert;
+use super::super::responses::{DailyMetric, DriverRating};
+use crate::db::models::DriverPerformanceMetrics;
+use crate::db::repositories::{list_driver_performance_metrics, list_driver_performance_ratings};
+use chrono::{Duration, Local};
+use sqlx::PgPool;
+
+const WINDOW_DAYS: i64 = 30;
+
+pub async fn recent_metrics(pool: &PgPool) -> Result<Vec<DriverPerformanceMetrics>, sqlx::Error> {
+    let cutoff = Local::now().date_naive() - Duration::days(WINDOW_DAYS);
+    Ok(list_driver_performance_metrics(pool)
+        .await?
+        .into_iter()
+        .filter(|row| row.metric_date >= cutoff)
+        .collect())
+}
+
+pub async fn recent_ratings(
+    pool: &PgPool,
+    driver_id: i32,
+) -> Result<Vec<DriverRating>, sqlx::Error> {
+    let mut rows: Vec<_> = list_driver_performance_ratings(pool)
+        .await?
+        .into_iter()
+        .filter(|row| row.driver_id == driver_id)
+        .collect();
+    rows.sort_by(|a, b| b.rated_at.cmp(&a.rated_at));
+    Ok(rows.iter().take(10).map(convert::rating_response).collect())
+}
+
+pub fn daily_metrics(metrics: &[DriverPerformanceMetrics], driver_id: i32) -> Vec<DailyMetric> {
+    let mut rows: Vec<_> = metrics
+        .iter()
+        .filter(|row| row.driver_id == driver_id)
+        .collect();
+    rows.sort_by(|a, b| b.metric_date.cmp(&a.metric_date));
+    rows.into_iter().map(convert::daily_metric).collect()
+}
