@@ -0,0 +1,51 @@
+import { eq } from 'drizzle-orm';
+import { service_bookings } from '../db/drizzle/schema.js';
+import { requireBookingDatabase } from './bookingDatabase.js';
+import { recordPaidBooking } from './recordPaidBooking.js';
+import { issueBookingReceipt } from './bookingReceipt.js';
+import { recordBookingChargeTelemetry } from './bookingChargeTelemetry.js';
+import type { chargeAcknowledgedBooking } from './bookingChargeGuard.js';
+import type { AuthorizeBookingChargeInput, AuthorizeBookingChargeOutput } from './bookingChargeSchemas.js';
+
+/** Reports payment and confirmed booking separately after provider confirmation.
+ * A finalization/receipt outage never invites the customer to pay a second time.
+ * @example `const outcome = await completeBookingCharge(input, authorized);`
+ */
+export async function completeBookingCharge(
+  input: AuthorizeBookingChargeInput,
+  authorized: Awaited<ReturnType<typeof chargeAcknowledgedBooking>>,
+): Promise<AuthorizeBookingChargeOutput> {
+  const { booking, held, charged } = authorized;
+  const result = { success: false, stripePaymentIntentId: charged.id,
+    amountChargedCents: charged.amount_received || null, paymentStatus: charged.status,
+    serviceStartsAt: null, receiptNumber: null, receiptEmailSent: false };
+  if (charged.status !== 'succeeded') {
+    await recordBookingChargeTelemetry(input, charged.id, 'non_succeeded_status');
+    return { ...result, message: charged.status === 'processing'
+      ? 'Your payment is processing. Do not submit another payment.'
+      : 'Payment is not confirmed. Review the checkout payment method.' };
+  }
+  let confirmed = false;
+  let receipt: Awaited<ReturnType<typeof issueBookingReceipt>> | null = null;
+  try {
+    await recordPaidBooking({ stripePaymentIntentId: charged.id,
+      amountPaidCents: charged.amount_received, estimatedDurationMinutes: booking.budgetedMinutes });
+    const [saved] = await requireBookingDatabase().select({
+      status: service_bookings.status, start: service_bookings.arrival_window_starts_at,
+    }).from(service_bookings).where(eq(service_bookings.id, booking.bookingId));
+    confirmed = saved?.status === 'confirmed' && Boolean(saved.start)
+      && new Date(saved.start!).getTime() === held.getTime();
+  } catch (error) {
+    console.error('[Booking] Paid booking finalization needs operations review:', error);
+  }
+  try { receipt = await issueBookingReceipt(booking.quoteId, charged.id, charged.amount_received); }
+  catch (error) { console.error('[Booking] Paid booking receipt needs delivery recovery:', error); }
+  await recordBookingChargeTelemetry(input, charged.id, undefined, charged, booking.bookingId);
+  return { ...result, success: confirmed, amountChargedCents: charged.amount_received,
+    serviceStartsAt: confirmed ? held.toISOString() : null,
+    receiptNumber: receipt?.receiptNumber ?? null, receiptEmailSent: receipt?.emailSent ?? false,
+    message: confirmed ? (receipt?.emailSent ? 'Payment collected and service booked. Your receipt was emailed.'
+      : 'Payment collected and service booked. Receipt delivery requires follow-up; do not pay again.')
+      : 'Payment collected; the service time requires operations review. Do not pay again.',
+  };
+}
