+import { z } from 'zod';
+import { BookingAuthorizationInputSchema, BookingSlotSchema } from './bookingSchemas.js';
+import { service_bookingsSelectSchema, exterior_quote_requestsSelectSchema } from '../db/drizzle/zod.js';
