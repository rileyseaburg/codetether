+/** Customer decline refers to the exact window currently displayed.
+ * @example `const input = ReleaseBookingInputSchema.parse(payload);` */
+export const ReleaseBookingInputSchema = BookingAuthorizationInputSchema.extend({
+  acknowledgedStart: BookingSlotSchema.shape.start,
+});
+
+/** Confirms cancellation and capacity release, never just a local UI change.
+ * @example `const result = ReleaseBookingOutputSchema.parse(response);` */
+export const ReleaseBookingOutputSchema = z.object({
+  quoteId: exterior_quote_requestsSelectSchema.shape.id,
+  bookingId: service_bookingsSelectSchema.shape.id,
+  released: z.literal(true),
+});
+
+/** Parsed decline request. @example `const input: ReleaseBookingInput = payload;` */
+export type ReleaseBookingInput = z.infer<typeof ReleaseBookingInputSchema>;
