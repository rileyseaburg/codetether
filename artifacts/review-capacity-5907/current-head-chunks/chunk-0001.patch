@@ -0,0 +1,34 @@
+import { and, eq, inArray, sql } from 'drizzle-orm';
+import { service_bookings as bookings, service_booking_status_events as events,
+  exterior_quote_requests as quotes, exterior_quote_payments as payments,
+  exterior_route_jobs as jobs } from '../db/drizzle/schema.js';
+import type { BookingTransaction } from './bookingDatabase.js';
+import type { BookingContext } from './bookingContextRepository.js';
+
+/** Releases capacity only after Stripe confirms cancellation of the bound intent.
+ * Runs inside the row-locking release transaction; no confirmed booking is changed.
+ * @example `await writeBookingRelease(tx, booking);`
+ */
+export async function writeBookingRelease(tx: BookingTransaction, booking: BookingContext) {
+  await tx.update(payments).set({ payment_status: 'cancelled' })
+    .where(and(eq(payments.id, booking.paymentId), eq(payments.payment_status, 'payment_pending')));
+  const [released] = await tx.update(bookings).set({
+    status: 'cancelled', cancelled_at: sql`now()`, hold_expires_at: null,
+    service_starts_at: null, service_ends_at: null,
+    arrival_window_starts_at: null, arrival_window_ends_at: null,
+    updated_at: sql`now()`, version: sql`${bookings.version} + 1`,
+  }).where(and(eq(bookings.id, booking.bookingId), inArray(bookings.status, ['awaiting_time', 'held'])))
+    .returning({ id: bookings.id });
+  if (!released) throw new Error('Booking changed before its hold could be released.');
+  await tx.update(quotes).set({ selected_window_start: null, selected_window_end: null,
+    routing_status: 'cancelled', updated_at: sql`now()`,
+  }).where(eq(quotes.id, booking.quoteId));
+  await tx.update(jobs).set({ selected_window_start: null, selected_window_end: null,
+    routing_status: 'cancelled', updated_at: sql`now()`,
+  }).where(eq(jobs.quote_request_id, booking.quoteId));
+  await tx.insert(events).values({ booking_id: booking.bookingId,
+    from_status: booking.status, to_status: 'cancelled', actor_type: 'customer',
+    reason: 'Customer declined the booking and cancelled the pending payment',
+    metadata: { stripe_payment_intent_id: booking.stripePaymentIntentId },
+  });
+}
