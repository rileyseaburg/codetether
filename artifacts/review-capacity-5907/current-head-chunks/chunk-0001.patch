@@ -0,0 +1,31 @@
+import { sql } from 'drizzle-orm';
+import { requireBookingDatabase, type BookingDatabase } from './bookingDatabase.js';
+import type { BookingContext } from './bookingContextRepository.js';
+
+/** Normalizes the capacity function's timestamp decoding across database drivers.
+ * @example `capacityTimestamp('2026-09-08T14:00:00Z');`
+ */
+function capacityTimestamp(value: unknown): Date {
+  const date = value instanceof Date ? value
+    : typeof value === 'string' ? new Date(value) : undefined;
+  if (!date || !Number.isFinite(date.getTime())) throw new TypeError('Invalid capacity slot timestamp');
+  return date;
+}
+
+/** Reads the canonical capacity function through bound Drizzle expressions.
+ * Scheduling rules remain in the existing database function, not in this reader.
+ * @example `const slots = await readBookingAvailabilitySlots(booking.bookingId);`
+ */
+export async function readBookingAvailabilitySlots(
+  bookingId: BookingContext['bookingId'],
+  db: BookingDatabase = requireBookingDatabase(), requestedStart?: Date,
+) {
+  const query = db.select({
+    start: sql`slots.service_start`.mapWith(capacityTimestamp),
+    serviceEnd: sql`slots.service_end`.mapWith(capacityTimestamp),
+    end: sql`slots.arrival_window_end`.mapWith(capacityTimestamp),
+    date: sql<string>`slots.service_date::text`,
+  }).from(sql`available_service_booking_slots(${bookingId}) AS slots`);
+  return requestedStart ? query.where(sql`slots.service_start = ${requestedStart.toISOString()}::timestamptz`).limit(1)
+    : query;
+}
