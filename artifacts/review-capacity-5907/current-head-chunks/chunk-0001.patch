+use crate::models::checkout::CreatePaymentIntentRequest;
+use crate::routes::api::analytics::AnalyticsEvent;
+use actix_web::{http::header, HttpRequest};
+use serde_json::{json, Value};
+
+use super::intent_analytics_persist::persist_checkout_event;
+use super::metadata_request::{preferred_param, session_identity};
+
+pub async fn record_intent_created(
+    payload: &CreatePaymentIntentRequest,
+    req: &HttpRequest,
+    response: &Value,
+) {
+    persist_checkout_event(checkout_event(payload, req, response)).await;
+}
+
+fn checkout_event(
+    payload: &CreatePaymentIntentRequest,
+    req: &HttpRequest,
+    response: &Value,
+) -> AnalyticsEvent {
+    let page_url = referer(req).unwrap_or_else(|| req.uri().to_string());
+    AnalyticsEvent {
+        uid: uid(payload, req),
+        session_id: payload.session_token.clone(),
+        event: "checkout_intent_created".to_string(),
+        event_id: format!("checkout_intent_created_{}", uuid::Uuid::new_v4()),
+        crm_lead_id: None,
+        legacy_lead_id: None,
+        page_url: page_url.clone(),
+        referrer: Some(page_url),
+        timestamp: chrono::Utc::now().timestamp_millis(),
+        client_data: checkout_data(payload, req, response),
