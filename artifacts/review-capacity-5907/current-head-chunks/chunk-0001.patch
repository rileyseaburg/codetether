+use actix_web::{post, web, HttpRequest, HttpResponse, Responder};
+use serde::Deserialize;
+use crate::controllers::checkout::exterior_booking::{booking_credential, proxy_booking_request};
+
+/// The exact arrival window being declined by the customer.
+///
+/// # Examples
+/// ```
+/// use launch_platform::controllers::checkout::exterior_booking_release::ReleaseBookingRequest;
+/// let body: ReleaseBookingRequest = serde_json::from_str(
+///     r#"{"acknowledgedStart":"2026-09-08T14:00:00Z"}"#,
+/// ).unwrap();
+/// assert!(body.acknowledged_start.ends_with('Z'));
+/// ```
+#[derive(Deserialize)]
+pub struct ReleaseBookingRequest {
+    #[serde(rename = "acknowledgedStart")]
+    pub acknowledged_start: String,
+}
+
+/// Proxies customer-authorized release to the owning booking/payment workflow.
+/// No cancellation, availability, or payment policy is duplicated in this handler.
+///
+/// # Examples
+/// ```no_run
+/// let app = actix_web::App::new().configure(launch_platform::routes::api::register);
+/// ```
+#[post("/exterior-booking/{quote_id}/release")]
+pub async fn release_exterior_booking(
+    quote_id: web::Path<i64>, request: HttpRequest,
+    payload: web::Json<ReleaseBookingRequest>,
+) -> impl Responder {
+    let Some(credential) = booking_credential(&request) else {
+        return HttpResponse::Unauthorized().finish();
+    };
+    proxy_booking_request("/orpc/exterior-quotes/release-booking", serde_json::json!({
+        "quoteRequestId": *quote_id, "credential": credential,
+        "acknowledgedStart": payload.acknowledged_start,
+    })).await
+}
