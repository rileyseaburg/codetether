+import { funnel_events } from '../db/drizzle/schema.js';
+import { requireBookingDatabase } from './bookingDatabase.js';
+import { enqueueCompatibilityEvent } from '../tracking/compatibilityOutbox.js';
+import type { AuthorizeBookingChargeInput } from './bookingChargeSchemas.js';
+import type Stripe from 'stripe';
+
+/** Emits non-critical charge telemetry through the canonical outbox and Drizzle.
+ * No provider exception text or payment credentials are included in event metadata.
+ * @example `await recordBookingChargeTelemetry(input, intent.id, 'provider_error');`
+ */
+export async function recordBookingChargeTelemetry(
+  input: AuthorizeBookingChargeInput, paymentIntentId: string, failureStage?: string,
+  paid?: Pick<Stripe.PaymentIntent, 'amount_received' | 'currency'>, bookingId?: string,
+) {
+  const eventId = failureStage ? `payment_failed_${paymentIntentId}_${Date.now()}` : `payment_${paymentIntentId}`;
+  const metadata = { source: 'service_calendar', service_type: 'exterior_cleaning',
+    failure_stage: failureStage, booking_id: bookingId, funnel_id: input.funnelId,
+    step_id: input.stepId, offer_id: input.offerId, test_id: input.testId, ab_variant: input.abVariant };
+  try {
+    await enqueueCompatibilityEvent({
+      eventType: failureStage ? 'payment_failed' : 'payment_completed', eventId,
+      sessionId: input.sessionId, pageUrl: input.pageUrl, timestamp: Date.now(),
+      transactionId: paymentIntentId, value: paid ? paid.amount_received / 100 : undefined,
+      currency: paid?.currency.toUpperCase(), analyticsConsent: input.analyticsConsent,
+      advertisingConsent: input.advertisingConsent, metadata,
+    });
+    await requireBookingDatabase().insert(funnel_events).values({
+      funnel_id: input.funnelId ?? null, step_id: input.stepId ?? null,
+      event_type: failureStage ? 'checkout_error' : 'purchase', value_cents: paid?.amount_received ?? null,
+      test_id: input.testId ?? null, variant: input.abVariant ?? null, offer_id: input.offerId ?? null,
+      source: 'service_calendar', meta: metadata, source_event_id: eventId, event_origin: 'server',
+    }).onConflictDoNothing();
+  } catch (error) {
+    console.error('[Booking Analytics] Charge telemetry could not be recorded:', error);
+  }
+}
