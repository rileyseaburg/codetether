+import { and, desc, eq, isNotNull } from 'drizzle-orm';
+import { exterior_quote_payments as payments } from '../db/drizzle/schema.js';
+import { requireBookingDatabase } from './bookingDatabase.js';
+
+/** Reads the existing quote-bound intent from generated database columns.
+ * @example `const intent = await readPendingQuoteIntent(quoteId);`
+ */
+export async function readPendingQuoteIntent(quoteId: number) {
+  const [row] = await requireBookingDatabase().select({
+    stripePaymentIntentId: payments.stripe_payment_intent_id,
+    amountQuotedCents: payments.amount_quoted_cents,
+  }).from(payments).where(and(eq(payments.quote_request_id, quoteId),
+    eq(payments.payment_status, 'payment_pending'), isNotNull(payments.stripe_payment_intent_id)))
+    .orderBy(desc(payments.id)).limit(1);
+  return row?.stripePaymentIntentId ? { ...row, stripePaymentIntentId: row.stripePaymentIntentId } : null;
+}
