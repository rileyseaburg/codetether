+
+const AD_CLICK_DEADLINE: Duration = Duration::from_millis(250);
+
+pub async fn record_ad_click_session(payload: &CreatePaymentIntentRequest, req: &HttpRequest) {
+    match tokio::time::timeout(
+        AD_CLICK_DEADLINE,
+        persist_generated(ad_click_session(payload, req)),
+    )
+    .await
+    {
+        Ok(Ok(())) => {}
+        Ok(Err(error)) => tracing::warn!(%error, "could not persist ad click session"),
+        Err(_) => tracing::warn!(
+            deadline_ms = AD_CLICK_DEADLINE.as_millis(),
+            "ad click session persistence timed out"
+        ),
+    }
+}
+
+async fn persist_generated(input: NewAdClickSessions) -> Result<(), String> {
+    let pool = crate::db_pool::get_or_init_pool().await?;
+    create_ad_click_sessions(pool, input)
+        .await
+        .map(|_| ())
+        .map_err(|error| error.to_string())
+}
+
+fn ad_click_session(p: &CreatePaymentIntentRequest, req: &HttpRequest) -> NewAdClickSessions {
+    let attr = RequestAttribution::current(req);
+    let session = session_id(p, req);
+    let page = attr
+        .referer
+        .clone()
+        .unwrap_or_else(|| req.uri().to_string());
+    let campaign = preferred_param(req, &p.utm_campaign, "utm_campaign");
+    NewAdClickSessions {
+        session_id: session,
+        customer_id: None,
+        utm_source: preferred_param(req, &p.utm_source, "utm_source"),
+        utm_medium: preferred_param(req, &p.utm_medium, "utm_medium"),
+        utm_campaign: campaign.clone(),
+        utm_content: preferred_param(req, &p.utm_content, "utm_content"),
+        utm_term: preferred_param(req, &p.utm_term, "utm_term"),
+        fbclid: request_param(req, "fbclid"),
+        fbc: preferred_param(req, &p.fbc, "_fbc"),
+        gclid: preferred_param(req, &p.gclid, "gclid"),
+        ttclid: preferred_param(req, &p.ttclid, "ttclid"),
+        landing_page_url: Some(page.clone()),
+        landing_page_id: None,
+        ad_creative_id: preferred_param(req, &p.utm_content, "utm_content"),
+        ad_campaign_id: campaign,
+        offer_id: None,
+        referrer_url: attr.referer,
+        landing_url: Some(page),
+        user_agent: attr.user_agent,
+        ip_address: Some(attr.client_ip),
+        clicked_at: Some(chrono::Utc::now()),
+        converted_at: None,
+        expires_at: None,
+        created_at: None,
+        journey_person_key: None,
+        journey_session_key: None,
+    }
+}
