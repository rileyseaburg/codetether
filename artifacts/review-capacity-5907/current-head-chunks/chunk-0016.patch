+++ b/tools/spotless-cli/template-payloads/service-calendar.generated.tera
@@ -0,0 +1,233 @@
+<!-- Generated from component-template-sources/service-calendar*. Do not edit generated output. -->
+{# Authored service_calendar component. @example render with cfg.quote_id and cfg.booking_credential. #}
+{% set quote_id = cfg.quote_id | default(value='') %}
+{% set component_id = cfg.component_id | default(value='exterior-booking') %}
+{% set endpoint = cfg.endpoint | default(value='') %}
+{% if quote_id and endpoint %}
+<section id="{{ component_id }}" data-service-calendar class="my-6 space-y-4 rounded-xl border p-5"
+  data-quote-id="{{ quote_id }}" data-endpoint="{{ endpoint }}"
+  data-preview="{{ cfg.preview | default(value=false) }}"
+  data-booking-credential="{{ cfg.booking_credential | default(value='') }}">
+  <header>
+    <h2 class="text-xl font-bold">Choose your service window</h2>
+    <p>Available windows come from our operations schedule.</p>
+    <p data-booking-timezone class="text-sm"></p>
+  </header>
+  <p data-booking-loading role="status">Loading real service availability…</p>
+  <p data-booking-error role="alert" class="hidden text-red-700"></p>
+  <button data-booking-retry type="button" class="hidden rounded border px-3 py-2">Refresh availability</button>
+  <fieldset data-booking-picker class="space-y-3">
+    <legend class="font-semibold">Select a date and arrival window</legend>
+    <div data-booking-dates class="flex flex-wrap gap-2"></div>
+    <div data-booking-times class="grid gap-2 sm:grid-cols-2"></div>
+  </fieldset>
+  <div data-booking-confirmation class="hidden rounded bg-emerald-50 p-4 text-emerald-950">
+    <p class="font-semibold">Service window held</p>
+    <p data-booking-confirmation-label></p>
+    <p data-booking-hold-copy class="text-sm"></p>
+    <button data-booking-change type="button" class="mt-3 underline">Choose another time</button>
+  </div>
+  <div data-booking-authorization class="hidden space-y-3 rounded border border-amber-300 p-4">
+    <h3 class="font-bold">Payment authorization</h3>
+    <p data-booking-authorization-detail></p>
+    <p>Your saved payment method is charged immediately when you confirm. This is not a card authorization hold.</p>
+    <button data-booking-authorize type="button" class="w-full rounded bg-emerald-700 p-3 font-bold text-white">
+      Yes, charge my card and book this service
+    </button>
+    <button data-booking-decline type="button" class="w-full underline">No thank you—cancel this checkout</button>
+  </div>
+  <p data-booking-result role="status" class="hidden rounded border p-4"></p>
+</section>
+<script>
+(() => {
+  'use strict';
+  /** Finds a control within one component instance. @example bookingControl(root, 'error'); */
+function bookingControl(root, name) {
+  return root.querySelector(`[data-booking-${name}]`);
+}
+
+/** Displays a real workflow failure without success or demo-slot substitution.
+ * @example showBookingError(root, message); */
+function showBookingError(root, message) {
+  const error = bookingControl(root, 'error');
+  error.textContent = message;
+  error.classList.remove('hidden');
+  bookingControl(root, 'loading').classList.add('hidden');
+  bookingControl(root, 'retry').classList.remove('hidden');
+}
+
+/** Sends a quote-authorized same-origin request without putting secrets in URLs.
+ * @example const response = await bookingRequest(root, url, payload); */
+async function bookingRequest(root, url, body) {
+  if (!root.dataset.bookingCredential) throw new Error('This secure booking session is unavailable.');
+  const target = new URL(url, location.origin);
+  if (target.origin !== location.origin) throw new Error('Invalid booking endpoint.');
+  const response = await fetch(target.href, {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json', 'X-Booking-Authorization': root.dataset.bookingCredential },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  let data;
+  try { data = await response.json(); }
+  catch { throw new Error('Booking returned an unreadable response. Your payment status may need review.'); }
+  if (!response.ok) throw new Error(data.message || data.error?.message || data.error || `Booking request failed (${response.status}).`);
+  return data;
+}
+
+/** Prevents double clicks across reserve, confirm, decline, and date selection.
+ * @example setBookingBusy(root, state, true); */
+function setBookingBusy(root, state, busy) {
+  state.busy = busy;
+  root.querySelectorAll('button').forEach(button => { button.disabled = busy || state.terminal; });
+}
+
+/** Shows the exact service/price/window that the customer is authorizing.
+ * @example displayBookingHold(root, state, response.slot); */
+function displayBookingHold(root, state, slot) {
+  state.held = slot;
+  const available = state.availability;
+  const price = new Intl.NumberFormat(undefined, { style: 'currency', currency: available.currency })
+    .format(available.amountQuotedCents / 100);
+  bookingControl(root, 'confirmation-label').textContent = slot.label;
+  bookingControl(root, 'hold-copy').textContent = `Held temporarily, up to ${available.reservationMinutes} minutes. Payment confirms the booking.`;
+  bookingControl(root, 'authorization-detail').textContent = `${available.serviceName}: charge ${price} now for ${slot.label}.`;
+  bookingControl(root, 'picker').classList.add('hidden');
+  bookingControl(root, 'confirmation').classList.remove('hidden');
+  bookingControl(root, 'authorization').classList.remove('hidden');
+}
+
+/** Stops further payment actions once a terminal or processing outcome is known.
+ * @example finishBookingUi(root, state, message); */
+function finishBookingUi(root, state, message) {
+  state.terminal = true;
+  bookingControl(root, 'authorization').classList.add('hidden');
+  const result = bookingControl(root, 'result');
+  result.textContent = message;
+  result.classList.remove('hidden');
+  setBookingBusy(root, state, false);
+}
+  /** Builds a selectable date from real server slot values. @example renderBookingDates(root, state); */
+function renderBookingDates(root, state) {
+  const dates = bookingControl(root, 'dates');
+  dates.replaceChildren();
+  const unique = [...new Set(state.slots.map(slot => slot.date))];
+  unique.forEach(date => {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.dataset.bookingDate = date;
+    button.textContent = date;
+    button.className = 'rounded border px-3 py-2';
+    dates.append(button);
+  });
+  if (unique.length) renderBookingTimes(root, state, unique[0]);
+}
+
+/** Uses server labels so displayed windows follow the operations timezone.
+ * @example renderBookingTimes(root, state, selectedDate); */
+function renderBookingTimes(root, state, date) {
+  const times = bookingControl(root, 'times');
+  times.replaceChildren();
+  root.querySelectorAll('[data-booking-date]').forEach(button => {
+    button.setAttribute('aria-pressed', String(button.dataset.bookingDate === date));
+  });
+  state.slots.filter(slot => slot.date === date).forEach(slot => {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.dataset.bookingStart = slot.start;
+    button.textContent = slot.label;
+    button.className = 'rounded border p-3 text-left';
+    times.append(button);
+  });
+}
+
+/** Loads only live availability with a real quote, credential, and quoted price.
+ * @example await loadBookingAvailability(root, state); */
+async function loadBookingAvailability(root, state) {
+  if (state.terminal) return;
+  bookingControl(root, 'error').classList.add('hidden');
+  bookingControl(root, 'loading').classList.remove('hidden');
+  bookingControl(root, 'confirmation').classList.add('hidden');
+  bookingControl(root, 'authorization').classList.add('hidden');
+  const id = Number(root.dataset.quoteId);
+  if (!Number.isSafeInteger(id) || id <= 0 || root.dataset.preview === 'true') {
+    throw new Error('Live availability requires a real booking quote; preview does not create slots.');
+  }
+  const data = await bookingRequest(root, `${root.dataset.endpoint}/availability`);
+  if (!Array.isArray(data.slots) || !data.timezone || !data.serviceName
+    || !Number.isSafeInteger(data.amountQuotedCents) || data.amountQuotedCents < 0 || !data.currency) {
+    throw new Error('Booking availability or the quoted price is incomplete.');
+  }
+  state.availability = data;
+  state.slots = data.slots;
+  state.held = data.selectedSlot;
+  bookingControl(root, 'timezone').textContent = data.timezone;
+  bookingControl(root, 'loading').classList.add('hidden');
+  renderBookingDates(root, state);
+  if (state.held) displayBookingHold(root, state, state.held);
+  else if (!state.slots.length) showBookingError(root, 'No service windows are currently available.');
+  else bookingControl(root, 'picker').classList.remove('hidden');
+}
+  /** Serializes customer actions and changes UI state only after server acknowledgment.
+ * @example await handleBookingClick(root, state, event); */
+async function handleBookingClick(root, state, event) {
+  const button = event.target instanceof Element ? event.target.closest('button') : null;
+  if (!button || !root.contains(button) || state.busy || state.terminal) return;
+  bookingControl(root, 'error').classList.add('hidden');
+  setBookingBusy(root, state, true);
+  try {
+    if (button.dataset.bookingDate) return renderBookingTimes(root, state, button.dataset.bookingDate);
+    if (button.matches('[data-booking-retry]')) return await loadBookingAvailability(root, state);
+    if (button.matches('[data-booking-change]')) {
+      bookingControl(root, 'confirmation').classList.add('hidden');
+      bookingControl(root, 'authorization').classList.add('hidden');
+      await loadBookingAvailability(root, state);
+      bookingControl(root, 'confirmation').classList.add('hidden');
+      bookingControl(root, 'authorization').classList.add('hidden');
+      return bookingControl(root, 'picker').classList.remove('hidden');
+    }
+    if (button.dataset.bookingStart) {
+      const response = await bookingRequest(root, `${root.dataset.endpoint}/reserve`, {
+        start: button.dataset.bookingStart,
+      });
+      if (response.status !== 'held' || !response.slot) throw new Error('The service window was not held.');
+      return displayBookingHold(root, state, response.slot);
+    }
+    if (!state.held) throw new Error('Choose a service window first.');
+    if (button.matches('[data-booking-decline]')) {
+      const response = await bookingRequest(root, `${root.dataset.endpoint}/release`, {
+        acknowledgedStart: state.held.start,
+      });
+      if (response.released !== true) throw new Error('The service window has not been released.');
+      state.held = null;
+      bookingControl(root, 'confirmation').classList.add('hidden');
+      bookingControl(root, 'picker').classList.add('hidden');
+      return finishBookingUi(root, state, 'No charge was made. Your pending checkout was cancelled and its service window released.');
+    }
+    if (button.matches('[data-booking-authorize]')) {
+      const response = await bookingRequest(root, '/api/exterior-booking/authorize-charge', {
+        quoteRequestId: Number(root.dataset.quoteId), acknowledgedStart: state.held.start,
+      });
+      if (response.success === true || response.amountChargedCents > 0 || response.paymentStatus === 'processing') {
+        root.dataset.chargeStatus = response.paymentStatus || (response.amountChargedCents > 0 ? 'succeeded' : 'unknown');
+        bookingControl(root, 'confirmation').classList.add('hidden');
+        bookingControl(root, 'picker').classList.add('hidden');
+        return finishBookingUi(root, state, response.message || 'Check your booking confirmation before taking another payment action.');
+      }
+      throw new Error(response.message || 'Payment has not been confirmed.');
+    }
+  } catch (error) {
+    showBookingError(root, error.message || 'The booking action could not be confirmed.');
+  } finally {
+    setBookingBusy(root, state, false);
+  }
+}
+  document.querySelectorAll('[data-service-calendar]').forEach(root => {
+    if (root.dataset.bookingReady === 'true') return;
+    root.dataset.bookingReady = 'true';
+    const state = { held: null, slots: [], busy: false, terminal: false, availability: null };
+    root.addEventListener('click', event => handleBookingClick(root, state, event));
+    loadBookingAvailability(root, state).catch(error => showBookingError(root, error.message));
+  });
+})();
+</script>
+{% endif %}
