+// Assemble the service-window component without publishing or invoking booking APIs.
+// Example: tetherscript run tools/spotless-cli/assemble-service-calendar.tether
+fn main() {
+    let root = "tools/spotless-cli/component-template-sources/"
+    let mut template = fs_read(root + "service-calendar.tera").unwrap()
+    let sources = [
+        ["SHARED", "service-calendar-shared.js"],
+        ["AVAILABILITY", "service-calendar-availability.js"],
+        ["ACTIONS", "service-calendar-actions.js"]
+    ]
+    for source in sources {
+        let marker = "// SERVICE_CALENDAR_" + source[0]
+        let script = fs_read(root + source[1]).unwrap()
+        if !template.contains(marker) { panic("Missing service-calendar assembly marker") }
+        if script.contains("</script") { panic("Inline script contains a closing script tag") }
+        template = template.replace(marker, script)
+    }
+    if template.contains("// SERVICE_CALENDAR_") { panic("Incomplete service-calendar assembly") }
+    let header = "<!-- Generated from component-template-sources/service-calendar*. Do not edit generated output. -->\n"
+    let output = "tools/spotless-cli/template-payloads/service-calendar.generated.tera"
+    fs_write(output, header + template).unwrap()
+    println(output)
+}
