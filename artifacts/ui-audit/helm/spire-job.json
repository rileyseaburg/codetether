    {
      "apiVersion":"batch/v1","kind":"Job","metadata":{},
      "spec":{"backoffLimit":0,"template":{"metadata":{},"spec":{
        "restartPolicy":"Never",
        "serviceAccountName":"t-a2a-server-harvester",
        "securityContext":{"runAsNonRoot":true,"runAsUser":1000,"fsGroup":1000},
        "imagePullSecrets":[{"name":"registry-credentials"}],
        "initContainers":[{
          "name":"spiffe-helper",
          "image":"ghcr.io/spiffe/spiffe-helper:0.10.0",
          "restartPolicy":"Always",
          "args":["-config","/spiffe-helper/helper.conf"],
          "securityContext":{"allowPrivilegeEscalation":false,"readOnlyRootFilesystem":true,"capabilities":{"drop":["ALL"]}},
          "resources":{"requests":{"cpu":"10m","memory":"32Mi"},"limits":{"cpu":"100m","memory":"64Mi"}},
          "startupProbe":{"exec":{"command":["test","-s","/svid/jwt_svid.token"]},"periodSeconds":1,"failureThreshold":60},
          "volumeMounts":[
            {"name":"spiffe-workload-api","mountPath":"/spiffe-workload-api","readOnly":true},
            {"name":"spiffe-helper-config","mountPath":"/spiffe-helper","readOnly":true},
            {"name":"svid","mountPath":"/svid"}
          ]
        }],
        "containers":[{
          "name":"worker",
          "image":"registry.quantum-forge.net/cluster-ci-cache/codetether-worker:latest",
          "command":["python3","/runner/job_worker.py"],
          "terminationMessagePath":"/tmp/job-result.json",
          "terminationMessagePolicy":"File",
          "securityContext":{"allowPrivilegeEscalation":false,"capabilities":{"drop":["ALL"]}},
          "env":[
            {"name":"PATH","value":"/runner:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"},
            {"name":"CODETETHER_SERVER","value":"http://a2a-server:8000"},
            {"name":"CODETETHER_SVID_PATH","value":"/svid/jwt_svid.token"},
            {"name":"HOME","value":"/work"},
            {"name":"XDG_CONFIG_HOME","value":"/work/.config"},
            {"name":"XDG_DATA_HOME","value":"/work/.local/share"},
            {"name":"CODETETHER_OPENAI_CODEX_ALLOW_CHATGPT_BACKEND","value":"1"},
            {"name":"CODETETHER_WORKER_TARGETED_ONLY","value":"true"},
            {"name":"CODETETHER_DEFAULT_MODEL","value":""},
            {"name":"VAULT_ADDR","value":"http://vault.vault.svc.cluster.local:8200"},
            {"name":"VAULT_ROLE","value":"codetether-harvester"},
            {"name":"VAULT_AUTH_MOUNT","value":"kubernetes"},
            {"name":"VAULT_K8S_SA_JWT_PATH","value":"/var/run/secrets/vault/token"},
            {"name":"VAULT_MOUNT","value":"secret"},
            {"name":"VAULT_SECRETS_PATH","value":"codetether/providers"},
            {"name":"JOB_RESULT_PATH","value":"/tmp/job-result.json"},
            {"name":"JOB_PRIVATE_LOG_PATH","value":"/work/worker.log"}
          ],
          "volumeMounts":[
            {"name":"runner","mountPath":"/runner","readOnly":true},
            {"name":"home","mountPath":"/work"},
            {"name":"workspace","mountPath":"/var/lib/codetether/repos"},
            {"name":"svid","mountPath":"/svid","readOnly":true},
            {"name":"vault-jwt","mountPath":"/var/run/secrets/vault","readOnly":true}
          ],
          "resources":{"requests":{"cpu":"500m","memory":"2Gi","ephemeral-storage":"6Gi"},
                       "limits":{"cpu":"4","memory":"6Gi","ephemeral-storage":"12Gi"}}
        }],
        "volumes":[
          {"name":"runner","configMap":{"name":"t-a2a-server-task-job-runner","defaultMode":365}},
          {"name":"home","emptyDir":{"sizeLimit":"8Gi"}},
          {"name":"spiffe-workload-api","csi":{"driver":"csi.spiffe.io","readOnly":true}},
          {"name":"spiffe-helper-config","configMap":{"name":"t-a2a-server-spiffe-helper"}},
          {"name":"svid","emptyDir":{"medium":"Memory","sizeLimit":"1Mi"}},
          {"name":"vault-jwt","projected":{"sources":[{"serviceAccountToken":{"audience":"vault","expirationSeconds":3600,"path":"token"}}]}}
        ]
      }}}}
