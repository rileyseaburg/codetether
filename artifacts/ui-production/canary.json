{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "codetether-marketing-canary",
        "namespace": "a2a-server"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "codetether-marketing-canary"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "codetether-marketing-canary"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "HOSTNAME",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "A2A_API_BACKEND",
                    "value": "http://codetether-a2a-server.a2a-server.svc.cluster.local:8000"
                  },
                  {
                    "name": "AUTH_TRUST_HOST",
                    "value": "true"
                  },
                  {
                    "name": "CONTACT_NOTIFICATION_EMAIL",
                    "value": "riley@spotlessbinco.com"
                  },
                  {
                    "name": "KEYCLOAK_CLIENT_ID",
                    "value": "a2a-monitor"
                  },
                  {
                    "name": "KEYCLOAK_ISSUER",
                    "value": "https://auth.quantum-forge.io/realms/quantum-forge"
                  },
                  {
                    "name": "SENDGRID_API_KEY"
                  },
                  {
                    "name": "SENDGRID_FROM_EMAIL",
                    "value": "noreply@codetether.run"
                  },
                  {
                    "name": "KEYCLOAK_CLIENT_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "KEYCLOAK_CLIENT_SECRET",
                        "name": "keycloak-client-secret"
                      }
                    }
                  },
                  {
                    "name": "AUTH_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "AUTH_SECRET",
                        "name": "keycloak-client-secret"
                      }
                    }
                  },
                  {
                    "name": "NEXTAUTH_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "AUTH_SECRET",
                        "name": "keycloak-client-secret"
                      }
                    }
                  }
                ],
                "image": "registry.quantum-forge.net/cluster-ci-cache/codetether-marketing:ui-a1d68a889bd3",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "marketing",
                "ports": [
                  {
                    "containerPort": 3000,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/",
                    "port": "http",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "imagePullSecrets": [
              {
                "name": "gcp-artifact-registry"
              },
              {
                "name": "registry-credentials"
              }
            ],
            "nodeName": "k8s-worker-2",
            "nodeSelector": {
              "kubernetes.io/hostname": "k8s-worker-2"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "codetether-marketing-canary",
        "namespace": "a2a-server"
      },
      "spec": {
        "selector": {
          "app": "codetether-marketing-canary"
        },
        "ports": [
          {
            "port": 3000,
            "targetPort": 3000
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "codetether-marketing-canary",
        "namespace": "a2a-server",
        "annotations": {
          "nginx.ingress.kubernetes.io/canary": "true",
          "nginx.ingress.kubernetes.io/canary-by-header": "X-CodeTether-Release",
          "nginx.ingress.kubernetes.io/canary-by-header-value": "a1d68a889bd3e752e5a00b6cfba90a0e9888c0c0"
        }
      },
      "spec": {
        "ingressClassName": "nginx",
        "tls": [
          {
            "hosts": [
              "codetether.run"
            ],
            "secretName": "codetether-marketing-tls"
          }
        ],
        "rules": [
          {
            "host": "codetether.run",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "codetether-marketing-canary",
                      "port": {
                        "number": 3000
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}