{
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "ruff.importStrategy": "fromEnvironment",
    "markdownlint.configFile": ".github/linters/.markdownlint.json",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
        "**/.codetether-worktrees/**": true,
        "**/.worktrees/**": true,
        "**/worktrees/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.next/**": true,
        "**/out/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/target/**": true,
        "**/.cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.spotless-cache/**": true,
        "**/coverage/**": true,
        "**/test-results/**": true,
        "**/playwright-report/**": true,
        "**/artifacts/**": true,
        "**/.codetether/memory-writeback/**": true,
        "**/.codetether/session-ledgers/**": true,
        "**/*.egg-info/**": true,
        "**/*.tsbuildinfo": true,
        "**/*.log": true
    },
    "files.watcherExclude": {
        "**/.codetether-worktrees/**": true,
        "**/.worktrees/**": true,
        "**/worktrees/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/__pycache__/**": true,
        "**/.next/**": true,
        "**/out/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/target/**": true,
        "**/.cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.spotless-cache/**": true,
        "**/coverage/**": true,
        "**/test-results/**": true,
        "**/playwright-report/**": true,
        "**/artifacts/**": true,
        "**/.codetether/memory-writeback/**": true,
        "**/.codetether/session-ledgers/**": true,
        "**/*.egg-info/**": true,
        "**/*.tsbuildinfo": true,
        "**/*.log": true
    },
    "files.exclude": {
        "**/.codetether-worktrees": true,
        "**/.worktrees": true,
        "**/worktrees": true,
        "**/node_modules": true,
        "**/.venv": true,
        "**/venv": true,
        "**/__pycache__": true,
        "**/.next": true,
        "**/out": true,
        "**/dist": true,
        "**/build": true,
        "**/target": true,
        "**/.cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.mypy_cache": true,
        "**/.spotless-cache": true,
        "**/coverage": true,
        "**/test-results": true,
        "**/playwright-report": true,
        "**/artifacts": true,
        "**/.codetether/memory-writeback": true,
        "**/.codetether/session-ledgers": true,
        "**/*.egg-info": true,
        "**/*.tsbuildinfo": true,
        "**/*.log": true
