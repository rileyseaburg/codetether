        "**/coverage/**",
        "**/test-results/**",
        "**/playwright-report/**",
        "**/artifacts/**",
        "**/.codetether/memory-writeback/**",
        "**/.codetether/session-ledgers/**",
        "**/*.egg-info/**",
        "**/*.tsbuildinfo",
        "**/*.log"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly"
