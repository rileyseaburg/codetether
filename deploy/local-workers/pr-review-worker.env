# Overrides layered on top of ~/.config/codetether/session-worker.env
# (which supplies CODETETHER_TOKEN / Vault). No secrets here.
# Role: read-only PR review chunks (FORGEJO_REVIEW_SAFE_WORKER=harvester-pr-review).
CODETETHER_WORKER_ID=ubuntu-dev-pr-review
CODETETHER_WORKER_TARGETED_ONLY=1
CODETETHER_WORKER_CAPABILITIES=review-readonly
CODETETHER_DEFAULT_MODEL=openai-codex/gpt-6-astra-fast:high
CODETETHER_OPENAI_CODEX_ALLOW_CHATGPT_BACKEND=1
CODETETHER_LOG_LEVEL=info
CODETETHER_HOME=/home/riley/.local/share/codetether-pr-review-worker
CODETETHER_AGENT_HOME=/home/riley/.local/share/codetether-pr-review-worker
XDG_DATA_HOME=/home/riley/.local/share/codetether-pr-review-worker/data
XDG_CACHE_HOME=/home/riley/.local/share/codetether-pr-review-worker/cache
GIT_CLONE_BASE=/home/riley/.local/share/codetether-pr-review-worker/repos
