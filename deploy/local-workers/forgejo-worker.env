# Overrides layered on top of ~/.config/codetether/session-worker.env
# (which supplies CODETETHER_TOKEN / Vault). No secrets here.
# Role: Forgejo issue/PR coding tasks, pinned server-side via
# GITHUB_APP_TARGET_AGENT=ubuntu-dev-forgejo.
CODETETHER_WORKER_ID=ubuntu-dev-forgejo
CODETETHER_WORKER_TARGETED_ONLY=1
CODETETHER_WORKER_CAPABILITIES=harvester,persistent,persistent-workspace,persistent_workspace,git-clone,repo-cache,session-context
CODETETHER_DEFAULT_MODEL=openai-codex/gpt-6-astra-fast:high
CODETETHER_OPENAI_CODEX_ALLOW_CHATGPT_BACKEND=1
CODETETHER_LOG_LEVEL=info
CODETETHER_HOME=/home/riley/.local/share/codetether-forgejo-worker
CODETETHER_AGENT_HOME=/home/riley/.local/share/codetether-forgejo-worker
XDG_DATA_HOME=/home/riley/.local/share/codetether-forgejo-worker/data
XDG_CACHE_HOME=/home/riley/.local/share/codetether-forgejo-worker/cache
GIT_CLONE_BASE=/home/riley/.local/share/codetether-forgejo-worker/repos
